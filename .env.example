# Environment example for StoryScapeAI
# Copy to `.env` and fill with real values before running the app.

# Postgres connection string (required for Prisma database access)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# App URL used for server-side integrations (optional for local dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI provider key (server-side only). Keep this secret and never commit to git.
# Example variable name only. Your integration may use different env names.
OPENAI_API_KEY=

# (Optional) NextAuth or other auth providers
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=
